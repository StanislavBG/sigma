# Replit configuration for Sigma. Full porting guide + data-seeding steps live in replit.md.
# Read replit.md FIRST — this file only wires the runtime; replit.md explains the
# Cloudflare-Workers → Node port and how the SQLite corpus reaches the Repl (it is NOT in git).

entrypoint = "replit.md"
hidden = ["node_modules", ".turbo", ".react-router", ".wrangler", "dist", "build"]
modules = ["nodejs-22"]

# Workspace run. `pnpm dev` currently boots the Cloudflare Workers dev server (Vite +
# miniflare), which emulates D1/R2/caches locally and reads the SQLite seeded under
# apps/web/.wrangler/state. On a fresh sync there is NO data — run `pnpm setup` once first
# (small sample) or restore the full corpus per replit.md before `pnpm dev`.
run = "pnpm dev"

[nix]
channel = "stable-24_05"

[env]
# Where the SQLite corpus lives on the Repl's persistent disk (never in git). The Node
# server adapter (replit.md → "Replit port checklist") reads this path; for the current
# miniflare dev path the data instead sits under apps/web/.wrangler/state.
SIGMA_DB_PATH = "/home/runner/${REPL_SLUG}/data-runtime/sigma.sqlite"
# Behind Replit's TLS-terminating proxy the app must NOT self-redirect http→https (it would 301 the
# health check and never go healthy). VITE_TRUST_PROXY is read at build time (apps/web/workers/app.ts).
VITE_TRUST_PROXY = "1"

[deployment]
# Reserved VM is the ONLY Replit deploy target with a persistent filesystem, which the
# SQLite corpus needs — Autoscale instances are stateless/ephemeral and would lose it.
# Switch to "autoscale" only if you migrate the data to Postgres (see replit.md).
deploymentTarget = "vm"
# No `corepack enable` — it tries to symlink pnpm into the read-only Nix store and fails with EACCES.
# pnpm is already on PATH. Schema is applied at runtime by serve.mjs (empty, no seed — real data only),
# so the build is just install + build.
build = ["sh", "-c", "export VITE_TRUST_PROXY=1; pnpm install --frozen-lockfile && pnpm build && pnpm --filter @sigma/web run build:replit"]
# `pnpm start` runs scripts/serve.mjs: the SSR app on an internal port + a token-protected POST /__ingest
# so this operator's machine can publish a fresh corpus daily (no redeploy). Set DATA_PUSH_TOKEN as a
# Replit *Secret* (Deployments → Secrets) to enable publishing; without it, ingest returns 503.
run = ["sh", "-c", "pnpm start"]

[[ports]]
localPort = 5175
externalPort = 3001

[[ports]]
localPort = 9232
externalPort = 3000
exposeLocalhost = true
